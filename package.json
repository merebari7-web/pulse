{
  "name": "pulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PULSE \u2014 an interactive, scroll-driven 3D field guide to the human heart. React Three Fiber + custom GLSL, GSAP ScrollTrigger, Lenis, Tailwind.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "check:logic": "node tools/test-logic.mjs",
    "check:shaders": "node tools/test-shaders.mjs",
    "check:scene": "esbuild tools/test-scene.mjs --bundle --platform=node --format=esm --packages=external --jsx=automatic --target=node20 --outfile=.tmp/test-scene.mjs --log-level=warning && node .tmp/test-scene.mjs",
    "check:dom": "esbuild tools/test-dom.mjs --bundle --platform=node --format=esm --packages=external --jsx=automatic --target=node20 --outfile=.tmp/test-dom.mjs --log-level=warning && node .tmp/test-dom.mjs",
    "check": "npm run check:logic && npm run check:shaders && npm run build && npm run check:scene && npm run check:dom"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "postprocessing": "^6.39.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@react-three/test-renderer": "^9.1.1",
    "@shaderfrog/glsl-parser": "^7.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
